# Proyecto de Supabase. Copia este archivo a .env.local y rellena los valores:
#   Supabase → Project Settings → API
#
# La clave anónima va al navegador a propósito: lo que protege los datos son
# las políticas RLS del esquema, no ocultar esta clave.
# Nunca pongas aquí la clave `service_role`.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-CLAVE-ANONIMA
